# Authenticate to GitHub Packages (npm.pkg.github.com) for the @vlinder-auth scope.
# In CI this is set via NODE_AUTH_TOKEN (GITHUB_TOKEN with packages:read permission).
# Locally, set NODE_AUTH_TOKEN to a PAT with read:packages scope.
@vlinder-auth:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
